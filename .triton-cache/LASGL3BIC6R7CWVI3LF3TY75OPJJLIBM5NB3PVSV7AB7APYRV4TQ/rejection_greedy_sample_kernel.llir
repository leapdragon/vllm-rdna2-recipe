  %31 = icmp sgt i32 %30, 0, !dbg !17
  %32 = tail call i32 @llvm.amdgcn.workitem.id.x()
  %33 = and i32 %32, 127
  br i1 %31, label %.lr.ph, label %._crit_edge, !dbg !17

.lr.ph:                                           ; preds = %25
  %34 = icmp eq i32 %33, 0
  %35 = add i32 %6, 1
  %36 = mul i32 %35, %11
  br label %37, !dbg !17

37:                                               ; preds = %.lr.ph, %55
  %38 = phi i1 [ false, %.lr.ph ], [ %56, %55 ]
  %39 = phi i32 [ 0, %.lr.ph ], [ %57, %55 ]
  br i1 %38, label %55, label %40, !dbg !18

40:                                               ; preds = %37
