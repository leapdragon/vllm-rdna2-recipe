  %55 = load <1 x i32>, ptr addrspace(1) %54, align 4, !dbg !24
  %56 = add i32 %5, 1, !dbg !25
  %57 = mul i32 %56, %9, !dbg !26
  %58 = add i32 %23, %57, !dbg !27
  %59 = sext i32 %58 to i64, !dbg !28
  %60 = getelementptr i32, ptr addrspace(1) %0, i64 %59, !dbg !28
  store <1 x i32> %55, ptr addrspace(1) %60, align 4, !dbg !28
  br label %61, !dbg !28

61:                                               ; preds = %._crit_edge, %53
  ret void, !dbg !29
