+    def _get_core_attn_out(
+        self, num_tokens: int, ref: torch.Tensor
+    ) -> torch.Tensor:
+        """Persistent zeroed output buffer for the GDN core op.
+
+        Replaces a per-call torch.zeros (one alloc per GDN layer per step,
+        48x/step at decode). Zeroed on (re)allocation; the core op fully
+        overwrites written lanes every call, so numerics are unchanged.
+        """
+        buf = getattr(self, "_core_attn_out", None)
+        need = (num_tokens, self.num_v_heads // self.tp_size, self.head_v_dim)
+        if buf is None or buf.shape != need or buf.dtype != ref.dtype:
+            buf = torch.zeros(need, dtype=ref.dtype, device=ref.device)
+            self._core_attn_out = buf
+        return buf
+
