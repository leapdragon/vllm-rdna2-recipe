17:                                               ; preds = %11, %8
  %18 = phi i32 [ %16, %11 ], [ 0, %8 ], !dbg !9
  %19 = sext i32 %9 to i64, !dbg !11
  %20 = getelementptr i32, ptr addrspace(1) %1, i64 %19, !dbg !11
  %21 = load <1 x i32>, ptr addrspace(1) %20, align 4, !dbg !11
  %22 = extractelement <1 x i32> %21, i64 0, !dbg !11
