  %12 = sext i32 %11 to i64
  %13 = getelementptr i32, ptr addrspace(1) %2, i64 %12
  %14 = load <1 x i32>, ptr addrspace(1) %13, align 4, !dbg !10
  %15 = extractelement <1 x i32> %14, i64 0, !dbg !10
  br label %16, !dbg !9

16:                                               ; preds = %10, %7
  %17 = phi i32 [ %15, %10 ], [ 0, %7 ], !dbg !9
  %18 = sext i32 %8 to i64, !dbg !11
  %19 = getelementptr i32, ptr addrspace(1) %2, i64 %18, !dbg !11
  %20 = load <1 x i32>, ptr addrspace(1) %19, align 4, !dbg !11
  %21 = extractelement <1 x i32> %20, i64 0, !dbg !11
  %22 = sub i32 %21, %17, !dbg !12
  %23 = getelementptr float, ptr addrspace(1) %1, i64 %18, !dbg !13
  %24 = load <1 x float>, ptr addrspace(1) %23, align 4, !dbg !13
  %25 = extractelement <1 x float> %24, i64 0, !dbg !13
  %26 = sitofp i32 %3 to float, !dbg !14
  %27 = fcmp oeq float %25, %26, !dbg !14
  %28 = sitofp i32 %4 to float, !dbg !15
  %29 = select i1 %27, float %28, float %25, !dbg !15
  %30 = tail call i32 @llvm.amdgcn.workitem.id.x(), !dbg !16
  %31 = and i32 %30, 127, !dbg !16
  %32 = icmp slt i32 %31, %22, !dbg !17
  %33 = add i32 %17, %31, !dbg !18
  %34 = tail call ptr addrspace(8) @llvm.amdgcn.make.buffer.rsrc.p8.p1(ptr addrspace(1) %0, i16 0, i64 2147483646, i32 822243328), !dbg !19
  %35 = shl i32 %33, 2, !dbg !19
  %36 = select i1 %32, i32 %35, i32 -2147483648, !dbg !19
  tail call void @llvm.amdgcn.raw.ptr.buffer.store.f32(float %29, ptr addrspace(8) %34, i32 %36, i32 0, i32 0), !dbg !19
