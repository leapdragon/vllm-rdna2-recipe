  %13 = sext i32 %12 to i64
  %14 = getelementptr i32, ptr addrspace(1) %1, i64 %13
  %15 = load <1 x i32>, ptr addrspace(1) %14, align 4, !dbg !10
  %16 = extractelement <1 x i32> %15, i64 0, !dbg !10
