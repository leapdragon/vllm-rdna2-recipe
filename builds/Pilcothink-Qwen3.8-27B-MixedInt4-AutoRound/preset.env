# summary: 27B AutoRound mixed int4 (needs the one-time conversions in BUILD.md), TP=2
PRESET_NAME="qwen38-27b-mixedint4"
MODEL="Pilcothink/Qwen3.8-27B-MixedInt4-AutoRound"
SERVED="qwen38-27b-mixedint4"
MTP_DEFAULT=2
CSV_DIR="$BUILDS/btbtyler09-Qwen3.8-27B-GPTQ-4bit/tunableop"   # lm_head shapes shared by all 27B quants
export FD_RDNA2=1 FD_MAXQ=4 FD_CHUNK=512 FD_TILE=32 FD_WARPS=8
export AR_RDNA2=1 AR_MAX_KB=512
export VLLM_DISABLED_KERNELS="RDNA3W4A16LinearKernel,RDNAHybridW4A16LinearKernel,TritonW4A16LinearKernel,ConchLinearKernel"
PRESET_ARGS="--dtype float16 --quantization gptq --attention-backend TRITON_ATTN --tensor-parallel-size 2 --disable-custom-all-reduce --max-model-len 131072 --gpu-memory-utilization 0.92 --kv-cache-dtype int8_per_token_head --max-num-seqs 8 --max-num-batched-tokens 8192 --enable-chunked-prefill --enable-prefix-caching --enable-prompt-tokens-details --enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3 --language-model-only --skip-mm-profiling --compilation-config {\"mode\":3,\"cudagraph_mode\":\"FULL_DECODE_ONLY\"}"
PRESET_NOTE="this checkpoint needs the one-time conversions in this build dir (convert.py + mtp_to_dense.py) applied to your HF cache first — see BUILD.md"
