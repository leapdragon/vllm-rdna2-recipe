  %21 = sext i32 %20 to i64
  %22 = getelementptr i32, ptr addrspace(1) %1, i64 %21
  %23 = load <1 x i32>, ptr addrspace(1) %22, align 4, !dbg !14
  %24 = extractelement <1 x i32> %23, i64 0, !dbg !14
  br label %25, !dbg !13

25:                                               ; preds = %19, %17
