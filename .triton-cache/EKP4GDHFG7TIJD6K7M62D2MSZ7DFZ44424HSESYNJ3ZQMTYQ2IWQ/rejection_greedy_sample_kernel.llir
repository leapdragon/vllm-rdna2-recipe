  %40 = load <2 x i32>, ptr addrspace(1) %39, align 8, !dbg !17
  %41 = extractelement <2 x i32> %40, i64 0, !dbg !18
  %42 = icmp ne i32 %38, %41, !dbg !19
  br i1 %27, label %43, label %48, !dbg !20

43:                                               ; preds = %33
  %44 = shufflevector <2 x i32> %40, <2 x i32> poison, <1 x i32> zeroinitializer, !dbg !20
  %45 = add i32 %32, %29, !dbg !21
  %46 = sext i32 %45 to i64, !dbg !20
  %47 = getelementptr i32, ptr addrspace(1) %0, i64 %46, !dbg !20
  store <1 x i32> %44, ptr addrspace(1) %47, align 4, !dbg !20
  br label %48, !dbg !20

48:                                               ; preds = %43, %33, %30
  %49 = phi i1 [ %42, %33 ], [ %42, %43 ], [ true, %30 ]
  %50 = add nuw nsw i32 %32, 1, !dbg !13
  %51 = icmp slt i32 %50, %23, !dbg !13
  br i1 %51, label %30, label %._crit_edge, !dbg !13

._crit_edge:                                      ; preds = %48, %17
  %.lcssa = phi i1 [ false, %17 ], [ %49, %48 ], !dbg !22
  %52 = icmp ne i32 %26, 0
  %or.cond.not = or i1 %52, %.lcssa, !dbg !23
  br i1 %or.cond.not, label %61, label %53, !dbg !23

53:                                               ; preds = %._crit_edge
