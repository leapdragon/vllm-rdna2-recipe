  %24 = icmp sgt i32 %23, 0, !dbg !13
  %25 = tail call i32 @llvm.amdgcn.workitem.id.x()
  %26 = and i32 %25, 127
  br i1 %24, label %.lr.ph, label %._crit_edge, !dbg !13

.lr.ph:                                           ; preds = %17
  %27 = icmp eq i32 %26, 0
  %28 = add i32 %5, 1
  %29 = mul i32 %28, %9
  br label %30, !dbg !13

30:                                               ; preds = %.lr.ph, %48
