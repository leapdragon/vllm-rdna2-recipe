  %42 = sext i32 %41 to i64, !dbg !20
  %43 = getelementptr i32, ptr addrspace(1) %2, i64 %42, !dbg !20
  %44 = load <1 x i32>, ptr addrspace(1) %43, align 4, !dbg !20
  %45 = extractelement <1 x i32> %44, i64 0, !dbg !20
  %46 = getelementptr i64, ptr addrspace(1) %3, i64 %42, !dbg !21
  %47 = load <2 x i32>, ptr addrspace(1) %46, align 8, !dbg !21
  %48 = extractelement <2 x i32> %47, i64 0, !dbg !22
  %49 = icmp ne i32 %45, %48, !dbg !23
  br i1 %34, label %50, label %55, !dbg !24

50:                                               ; preds = %40
  %51 = shufflevector <2 x i32> %47, <2 x i32> poison, <1 x i32> zeroinitializer, !dbg !24
  %52 = add i32 %39, %36, !dbg !25
  %53 = sext i32 %52 to i64, !dbg !24
  %54 = getelementptr i32, ptr addrspace(1) %0, i64 %53, !dbg !24
  store <1 x i32> %51, ptr addrspace(1) %54, align 4, !dbg !24
  br label %55, !dbg !24

55:                                               ; preds = %50, %40, %37
  %56 = phi i1 [ %49, %40 ], [ %49, %50 ], [ true, %37 ]
  %57 = add nuw nsw i32 %39, 1, !dbg !17
  %58 = icmp slt i32 %57, %30, !dbg !17
  br i1 %58, label %37, label %._crit_edge, !dbg !17

._crit_edge:                                      ; preds = %55, %25
  %.lcssa = phi i1 [ false, %25 ], [ %56, %55 ], !dbg !26
  %59 = icmp ne i32 %33, 0
  %or.cond.not = or i1 %59, %.lcssa, !dbg !27
  br i1 %or.cond.not, label %16, label %60, !dbg !27

60:                                               ; preds = %._crit_edge
  %61 = getelementptr i32, ptr addrspace(1) %4, i64 %12, !dbg !28
  %62 = load <1 x i32>, ptr addrspace(1) %61, align 4, !dbg !28
  %63 = add i32 %6, 1, !dbg !29
  %64 = mul i32 %63, %11, !dbg !30
  %65 = add i32 %30, %64, !dbg !31
  %66 = sext i32 %65 to i64, !dbg !32
  %67 = getelementptr i32, ptr addrspace(1) %0, i64 %66, !dbg !32
  store <1 x i32> %62, ptr addrspace(1) %67, align 4, !dbg !32
